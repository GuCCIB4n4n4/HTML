<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Ganadotropin Site</title>

<style>
/* RESET */
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, Helvetica, sans-serif; line-height: 1.45; color: #222; background: #fff; }
img { max-width: 100%; display: block; }

/* LAYOUT */
.container { max-width: 1100px; margin: 0 auto; padding: 24px; }

/* HEADER */
.site-header { background: #ffffff; border-bottom: 1px solid #e8e8e8; }
.header-inner { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; }
.brand { font-size: 22px; font-weight: bold; letter-spacing: 1px; color: #000; text-decoration: none; }
.site-nav a { margin-left: 20px; text-decoration: none; color: #333; font-size: 16px; }

/* HERO */
.hero { background: #f7f7f7; padding: 60px 0; }
.hero-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
.hero-text { flex: 1; }
.hero-text h1 { font-size: 42px; margin-bottom: 12px; }
.hero-text p { font-size: 18px; margin-bottom: 18px; color: #444; }
.btn { display: inline-block; padding: 12px 18px; background: royalblue; color: #fff; text-decoration: none; border-radius: 6px; }
.hero-media img { border-radius: 12px; }

/* CONTENT BLOCK */
section.content-block { padding: 50px 0; }
section.content-block h2 { font-size: 32px; margin-bottom: 12px; }
section.content-block p { font-size: 17px; color: #444; }

/* CARD GRID */
.cards { display: grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 22px; margin: 40px auto; }
.card { background: #fff; border-radius: 12px; padding: 16px; box-shadow: 0 6px 18px rgba(0,0,0,0.07); text-align: center; }
.card img { border-radius: 10px; margin-bottom: 10px; }
.card h3 { margin-bottom: 8px; }

/* FOOTER */
.site-footer { background: #111; color: #fff; padding: 20px 0; margin-top: 50px; }
.footer-inner { display: flex; justify-content: space-between; align-items: center; }

/* RESPONSIVE */
@media(max-width: 800px) {
  .hero-inner { flex-direction: column; text-align: center; }
  .site-nav { display: none; }
}
</style>
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container header-inner">
    <a href="index.html" class="brand">GANADOTROPIN</a>
    <nav class="site-nav">
      <a href="index.html">Home</a>
      <a href="about.html">About</a>
      <a href="projects.html">Projects</a>
      <a href="contact.html">Contact</a>
    </nav>
  </div>
</header>

<!-- HERO SECTION -->
<section class="hero">
  <div class="container hero-inner">

    <div class="hero-text">
      <h1>Your Canva Heading Here</h1>
      <p>Your subheading or short description goes here. Replace all text with your exact Canva content.</p>
      <a href="#" class="btn">Learn More</a>
    </div>

    <div class="hero-media">
      <!-- Replace with: assets/img/yourimage.jpg -->
      <img src="https://via.placeholder.com/500x350" alt="Hero Image">
    </div>

  </div>
</section>

<!-- CONTENT SECTION 1 -->
<section class="content-block">
  <div class="container">
    <h2>Section Title</h2>
    <p>Replace this text with the exact paragraph from the Canva page. Add more text as needed.</p>
  </div>
</section>

<!-- CARD GRID -->
<section class="container">
  <div class="cards">

    <div class="card">
      <img src="https://via.placeholder.com/400x250" alt="">
      <h3>Card Title 1</h3>
      <p>Replace this with your Canva card description.</p>
    </div>

    <div class="card">
      <img src="https://via.placeholder.com/400x250" alt="">
      <h3>Card Title 2</h3>
      <p>Replace this with your Canva card description.</p>
    </div>

    <div class="card">
      <img src="https://via.placeholder.com/400x250" alt="">
      <h3>Card Title 3</h3>
      <p>Replace this with your Canva card description.</p>
    </div>

  </div>
</section>

<!-- CONTENT SECTION 2 -->
<section class="content-block">
  <div class="container">
    <h2>Another Section Title</h2>
    <p>Again, replace this content with the exact wording from your Canva webpage.</p>
  </div>
</section>

<!-- FOOTER -->
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© <span id="year"></span> Ganadotropin. All rights reserved.</p>
  </div>
</footer>

<script>
document.getElementById("year").innerText = new Date().getFullYear();
</script>

</body>
</html>
